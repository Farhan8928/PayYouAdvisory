{
  "name": "payyou-advisory",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "PayYou Advisory Private Ltd. - loan advisory (DSA) in Pune & PCMC. Static-rendered React site.",
  "scripts": {
    "dev": "vite",
    "images": "node scripts/fetch-images.mjs",
    "logos": "node scripts/fetch-logos.mjs",
    "brand": "node scripts/make-brand-assets.mjs",
    "pdf": "node scripts/make-client-pdf.mjs",
    "links": "node scripts/make-link-list.mjs",
    "build:ssr": "vite build --ssr src/entry-server.jsx --outDir dist-ssr",
    "build": "vite build && node scripts/css-audit.mjs && npm run build:ssr && node scripts/prerender.mjs && node scripts/brand-audit.mjs && node scripts/image-audit.mjs && node scripts/duplication-audit.mjs && node scripts/ai-tells-audit.mjs && node scripts/seo-audit.mjs",
    "build:fast": "vite build",
    "preview": "vite preview",
    "audit:css": "node scripts/css-audit.mjs",
    "audit:brand": "node scripts/brand-audit.mjs",
    "audit:images": "node scripts/image-audit.mjs",
    "audit:dupes": "node scripts/duplication-audit.mjs",
    "audit:tells": "node scripts/ai-tells-audit.mjs",
    "audit:viewport": "node scripts/viewport-audit.mjs",
    "audit:seo": "node scripts/seo-audit.mjs",
    "hero": "node scripts/make-hero-images.mjs"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "4.3.4",
    "autoprefixer": "10.4.20",
    "playwright-core": "^1.49.1",
    "postcss": "8.4.49",
    "sharp": "0.33.5",
    "tailwindcss": "3.4.17",
    "vite": "5.4.11"
  }
}
